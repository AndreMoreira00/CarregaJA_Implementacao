        {
          "name": "Sem token: recusado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/veiculos/meu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "veiculos",
                "meu"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Senha incorreta: recusada, sem dizer qual campo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSindica}}\",\n  \"senha\": \"errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "const corpo = pm.response.text() ? pm.response.json() : {};",
                  "pm.test(\"Mensagem: E-mail ou senha incorretos.\", () => pm.expect(corpo.mensagem).to.include(\"E-mail ou senha incorretos.\"));"
