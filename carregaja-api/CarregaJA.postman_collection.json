{
  "info": {
    "name": "CarregaJA API",
    "description": "Roteiro de demonstração da carregaja-api, com os dados da História de Usuário.\n\n**Como usar:** rode `scripts\\zerar-banco.bat` e depois execute a coleção inteira, de cima para baixo, no Collection Runner. Cada requisição confere a própria resposta, e os tokens e ids são guardados nas variáveis da coleção. A ordem importa: a pasta 1 troca a senha da síndica, e a coleção só roda de novo depois de zerar o banco.\n\nOs demais cenários dos testes de aceitação estão nos testes de unidade da API (`scripts\\testar-api.bat`). O encerramento da sessão é do sprint 6: para repetir o início da recarga, zere o banco.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "emailSindica",
      "value": "sindica@carregaja.test",
      "type": "string"
    },
    {
      "key": "senhaSindicaProvisoria",
      "value": "provisoria-sindica",
      "type": "string"
    },
    {
      "key": "senhaProvisoria",
      "value": "provisoria123",
      "type": "string"
    },
    {
      "key": "senhaDefinitiva",
      "value": "senha-definitiva-1",
      "type": "string"
    },
    {
      "key": "tokenSindica",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAna",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenCarlos",
      "value": "",
      "type": "string"
    },
    {
      "key": "idG01",
      "value": "",
      "type": "string"
    },
    {
      "key": "idG02",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. UC01: a síndica entra",
      "description": "Os dados da síndica vêm de `scripts\\config.bat`.",
      "item": [
        {
          "name": "Senha incorreta: recusada, sem dizer qual campo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSindica}}\",\n  \"senha\": \"errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "const corpo = pm.response.text() ? pm.response.json() : {};",
                  "pm.test(\"Mensagem: E-mail ou senha incorretos.\", () => pm.expect(corpo.mensagem).to.include(\"E-mail ou senha incorretos.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com a senha provisória",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSindica}}\",\n  \"senha\": \"{{senhaSindicaProvisoria}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.text() ? pm.response.json() : {};",
                  "pm.test(\"Precisa trocar a senha\", () => pm.expect(corpo.usuario.trocarSenha).to.eql(true));",
                  "pm.collectionVariables.set(\"tokenSindica\", corpo.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Com a senha provisória, o resto é negado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenSindica}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Troca a senha: o acesso é liberado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autenticacao/senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autenticacao",
                "senha"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"{{senhaSindicaProvisoria}}\",\n  \"senhaNova\": \"{{senhaDefinitiva}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenSindica}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
